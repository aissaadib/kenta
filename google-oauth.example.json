{
  // ClipVault Google OAuth desktop client configuration.
  //
  // 1. Create a Google Cloud project and enable the Google Drive API.
  // 2. Configure the OAuth consent screen (internal or published, depending on
  //    who will use this build).
  // 3. Create credentials > OAuth client ID > Desktop app.
  // 4. Copy the client ID below. The client secret is optional: a desktop app
  //    is a public client, so ClipVault never treats it as confidential.
  //
  // Save this file as google-oauth.json next to ClipVault.exe, or in
  // %APPDATA%\ClipVault\google-oauth.json. The file is gitignored: never
  // commit real credentials.
  //
  // Alternatively set CLIPVAULT_GOOGLE_CLIENT_ID (and optionally
  // CLIPVAULT_GOOGLE_CLIENT_SECRET) in the environment.
  "client_id": "YOUR_CLIENT_ID.apps.googleusercontent.com",
  "client_secret": ""
}

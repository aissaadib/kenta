{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kenta",
  "version": "0.1.0",
  "identifier": "com.kenta.app",
  "build": {
    "frontendDist": "../web/dist",
    "beforeDevCommand": "cd web && npm run dev",
    "beforeBuildCommand": "cd web && npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Kenta",
        "width": 1000,
        "height": 700,
        "theme": "Dark",
        "resizable": true,
        "fullscreen": false,
        "minimizable": true,
        "maximizable": true,
        "closable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data: blob:; media-src 'self' asset: http://asset.localhost blob:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "HumanHEART",
    "copyright": "Copyright (c) 2026 HumanHEART",
    "category": "Video",
    "shortDescription": "Local-first replay recorder for Windows",
    "longDescription": "Kenta keeps a rolling replay buffer of your desktop and saves the last moments on demand. Clips stay on your PC; Google Drive backup is optional.",
    "homepage": "https://github.com/aissaadib/kenta",
    "license": "MIT",
    "licenseFile": "../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "google-oauth.json": "google-oauth.json",
      "../LICENSE": "LICENSE",
      "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md",
      "../LICENSES/GPL-3.0.txt": "LICENSES/GPL-3.0.txt"
    },
    "externalBin": ["binaries/ffmpeg", "binaries/ffprobe"],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English"],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "startMenuFolder": "Kenta",
        "compression": "lzma"
      }
    }
  }
}
